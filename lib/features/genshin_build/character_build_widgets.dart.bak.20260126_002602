class AscensionTableCard extends StatelessWidget {
  final AscensionTableData table;
  const AscensionTableCard({super.key, required this.table});

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const SectionTitle('Ascension Costs'),
        const SizedBox(height: 8),
        Container(
          decoration: BoxDecoration(
            color: Colors.black.withOpacity(0.25),
            borderRadius: BorderRadius.circular(10),
            border: Border.all(color: Colors.white10),
          ),
          padding: const EdgeInsets.all(10),
          child: SingleChildScrollView(
            scrollDirection: Axis.horizontal,
            child: ConstrainedBox(
              constraints: const BoxConstraints(minWidth: 820),
              child: Table(
                border: TableBorder.all(color: Colors.white10),
                defaultVerticalAlignment: TableCellVerticalAlignment.middle,
                children: [
                  _headerRow(table.headers),
                  ...table.rows.map(_dataRow),
                ],
              ),
            ),
          ),
        ),
      ],
    );
  }

  TableRow _headerRow(List<String> headers) {
    return TableRow(
      decoration: BoxDecoration(color: Colors.white10),
      children: headers
          .map((h) => Padding(
                padding: const EdgeInsets.all(8),
                child: Text(
                  h,
                  style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w900, fontSize: 12),
                ),
              ))
          .toList(),
    );
  }

  TableRow _dataRow(List<AscensionCell> row) {
    return TableRow(
      children: row.map((c) {
        if (c.image != null) {
          return Padding(
            padding: const EdgeInsets.all(8),
            child: Row(
              children: [
                _imgWithCount(c.image!.url, c.image!.count),
                const SizedBox(width: 8),
                Expanded(
                  child: Text(
                    c.text.replaceAll(RegExp(r'\s+'), ' ').trim(),
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(color: Colors.white, fontSize: 12.5),
                  ),
                ),
              ],
            ),
          );
        }
        return Padding(
          padding: const EdgeInsets.all(8),
          child: Text(c.text, style: const TextStyle(color: Colors.white, fontSize: 12.5)),
        );
      }).toList(),
    );
  }

  Widget _imgWithCount(String url, int? count) {
    return Stack(
      clipBehavior: Clip.none,
      children: [
        ClipRRect(
          borderRadius: BorderRadius.circular(6),
          child: Container(
            width: 28,
            height: 28,
            color: Colors.white10,
            child: Image.network(url, fit: BoxFit.cover),
          ),
        ),
        if (count != null)
          Positioned(
            right: -6,
            bottom: -6,
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
              decoration: BoxDecoration(
                color: Colors.black.withOpacity(0.75),
                borderRadius: BorderRadius.circular(999),
                border: Border.all(color: Colors.white12),
              ),
              child: Text(
                '$count',
                style: const TextStyle(color: Colors.white, fontSize: 11, fontWeight: FontWeight.w900),
              ),
            ),
          ),
      ],
    );
  }
}


