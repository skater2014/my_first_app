const _bg = Color(0xFF070A12);
const _bar = Color(0xFF27306A);
const _bar2 = Color(0xFF1E2657);

class CharacterDetailLayout extends StatelessWidget {
  final CharacterPageData data;
  const CharacterDetailLayout({super.key, required this.data});

  @override
  Widget build(BuildContext context) {
    return Container(
      color: _bg,
      child: LayoutBuilder(
        builder: (context, c) {
          final twoCol = c.maxWidth >= 1200;

          if (!twoCol) {
            return ListView(
              padding: const EdgeInsets.fromLTRB(12, 12, 12, 24),
              children: [
                HeaderCard(data: data),
                const SizedBox(height: 12),
                MaterialsGridCard(data: data),
                const SizedBox(height: 12),
                RankedSectionCard(
                  title: '${data.name} Best Weapons',
                  items: data.bestWeapons,
                  showCount: false,
                ),
                const SizedBox(height: 12),
                RankedSectionCard(
                  title: '${data.name} Best Artifacts',
                  items: data.bestArtifacts,
                  showCount: true,
                ),
                const SizedBox(height: 12),
                StatsCard(lines: data.bestStatsLines),

                // ✅ 追加：Talents / Passives / Constellations
                const SizedBox(height: 12),
                SkillGroupsView(groups: data.skillGroups),

                if (data.showcaseVideoId.trim().isNotEmpty) ...[
                const SizedBox(height: 12),
                YoutubeEmbed(
                  videoId: data.showcaseVideoId,
                  title: '${data.name} Showcase',
                ),
                ],

                if (data.ascension != null) ...[
                  const SizedBox(height: 12),
                  AscensionTableCard(table: data.ascension!),
                ],
              ],
            );
          }

          return SingleChildScrollView(
            padding: const EdgeInsets.fromLTRB(12, 12, 12, 24),
            child: Column(
              children: [
                HeaderCard(data: data),
                const SizedBox(height: 12),
                Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Expanded(
                      flex: 6,
                      child: Column(
                        children: [
                          MaterialsGridCard(data: data),
                          const SizedBox(height: 12),
                          RankedSectionCard(
                            title: '${data.name} Best Weapons',
                            items: data.bestWeapons,
                            showCount: false,
                          ),
                          const SizedBox(height: 12),
                          RankedSectionCard(
                            title: '${data.name} Best Artifacts',
                            items: data.bestArtifacts,
                            showCount: true,
                          ),
                          const SizedBox(height: 12),
                          StatsCard(lines: data.bestStatsLines),

                const SizedBox(height: 12),
                SkillGroupsView(groups: data.skillGroups),

                if (data.showcaseVideoId.trim().isNotEmpty) ...[
                const SizedBox(height: 12),
                YoutubeEmbed(
                  videoId: data.showcaseVideoId,
                  title: '${data.name} Showcase',
                ),
                ],
                        ],
                      ),
                    ),
                    const SizedBox(width: 12),
                    const Expanded(
                      flex: 4,
                      child: Column(
                        children: [
                          // TODO: Navigation / Showcase / Skills をここに追加
                        ],
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 12),
                if (data.ascension != null) AscensionTableCard(table: data.ascension!),
              ],
            ),
          );
        },
      ),
    );
  }
}

class SectionTitle extends StatelessWidget {
  final String text;
  const SectionTitle(this.text, {super.key});
  @override
  Widget build(BuildContext context) => Text(
        text,
        style: const TextStyle(
          color: Color(0xFFFFD54A),
          fontSize: 13,
          fontWeight: FontWeight.w900,
        ),
      );
}

class HeaderCard extends StatelessWidget {
  final CharacterPageData data;
  const HeaderCard({super.key, required this.data});

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Colors.black.withOpacity(0.25),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: Colors.white10),
      ),
      child: Row(
        children: [
          ClipRRect(
            borderRadius: BorderRadius.circular(14),
            child: Container(
              width: 72,
              height: 72,
              color: Colors.white10,
              child: data.portraitUrl.isEmpty
                  ? const Icon(Icons.person, color: Colors.white54)
                  : Image.network(
                      data.portraitUrl,
                      fit: BoxFit.cover,
                      errorBuilder: (_, __, ___) =>
                          const Icon(Icons.broken_image, color: Colors.white54),
                    ),
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Text(
                data.name,
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 22,
                  fontWeight: FontWeight.w800,
                ),
              ),
              const SizedBox(height: 8),
              Wrap(
                spacing: 10,
                runSpacing: 8,
                children: data.pills.map((p) => _pill(p.text, p.iconUrl)).toList(),
              ),
            ]),
          ),
        ],
      ),
    );
  }

  Widget _pill(String text, String iconUrl) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
      decoration: BoxDecoration(
        color: Colors.white10,
        borderRadius: BorderRadius.circular(999),
        border: Border.all(color: Colors.white12),
      ),
      child: Row(mainAxisSize: MainAxisSize.min, children: [
        if (iconUrl.trim().isNotEmpty) ...[
          Image.network(iconUrl, width: 16, height: 16, fit: BoxFit.contain),
          const SizedBox(width: 6),
        ],
        Text(
          text,
          style: const TextStyle(color: Colors.white, fontSize: 12.5, fontWeight: FontWeight.w700),
        ),
      ]),
    );
  }
}

class MaterialsGridCard extends StatelessWidget {
  final CharacterPageData data;
  const MaterialsGridCard({super.key, required this.data});

  @override
  Widget build(BuildContext context) {
    if (data.materials.isEmpty) return const SizedBox.shrink();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        SectionTitle('${data.name} Upgrade Materials'),
        const SizedBox(height: 8),
        GridView.builder(
          shrinkWrap: true,
          physics: const NeverScrollableScrollPhysics(),
          itemCount: data.materials.length,
          gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
            crossAxisCount: 2,
            mainAxisSpacing: 8,
            crossAxisSpacing: 8,
            childAspectRatio: 3.8,
          ),
          itemBuilder: (_, i) {
            final m = data.materials[i];
            return Container(
              decoration: BoxDecoration(
                color: _bar,
                borderRadius: BorderRadius.circular(6),
                border: Border.all(color: Colors.white10),
              ),
              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
              child: Row(
                children: [
                  if (m.iconUrl.isNotEmpty)
                    Image.network(m.iconUrl, width: 18, height: 18, fit: BoxFit.contain),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Text(
                      m.name,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 12.5,
                        fontWeight: FontWeight.w800,
                      ),
                    ),
                  ),
                ],
              ),
            );
          },
        ),
      ],
    );
  }
}

class RankedSectionCard extends StatelessWidget {
  final String title;
  final List<RankedData> items;
  final bool showCount;
  const RankedSectionCard({
    super.key,
    required this.title,
    required this.items,
    required this.showCount,
  });

  @override
  Widget build(BuildContext context) {
    if (items.isEmpty) return const SizedBox.shrink();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        SectionTitle(title),
        const SizedBox(height: 8),
        ...items.map((x) => _row(x)).toList(),
      ],
    );
  }

  Widget _row(RankedData x) {
    return Container(
      margin: const EdgeInsets.only(bottom: 8),
      decoration: BoxDecoration(
        color: _bar,
        borderRadius: BorderRadius.circular(6),
        border: Border.all(color: Colors.white10),
      ),
      child: Row(
        children: [
          Container(
            width: 34,
            height: 42,
            alignment: Alignment.center,
            decoration: BoxDecoration(
              color: _bar2,
              borderRadius: const BorderRadius.only(
                topLeft: Radius.circular(6),
                bottomLeft: Radius.circular(6),
              ),
            ),
            child: Text(
              '${x.rank}',
              style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w900),
            ),
          ),
          const SizedBox(width: 10),
          ClipRRect(
            borderRadius: BorderRadius.circular(6),
            child: Container(
              width: 28,
              height: 28,
              color: Colors.white10,
              child: x.iconUrl.isEmpty
                  ? const SizedBox.shrink()
                  : Image.network(x.iconUrl, fit: BoxFit.cover),
            ),
          ),
          const SizedBox(width: 10),
          Expanded(
            child: Text(
              x.name,
              overflow: TextOverflow.ellipsis,
              style: const TextStyle(
                color: Colors.white,
                fontSize: 12.8,
                fontWeight: FontWeight.w800,
              ),
            ),
          ),
          if (showCount && x.count != null)
            Container(
              margin: const EdgeInsets.only(right: 10),
              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
              decoration: BoxDecoration(
                color: Colors.white10,
                borderRadius: BorderRadius.circular(999),
                border: Border.all(color: Colors.white12),
              ),
              child: Text(
                '${x.count}',
                style: const TextStyle(color: Colors.white, fontSize: 12, fontWeight: FontWeight.w900),
              ),
            ),
        ],
      ),
    );
  }
}

