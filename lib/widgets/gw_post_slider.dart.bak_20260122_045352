import 'package:flutter/foundation.dart'
    show kIsWeb, defaultTargetPlatform, TargetPlatform;
import 'package:flutter/material.dart';
import 'package:cached_network_image/cached_network_image.dart';

import '../model/gw_slider_item.dart';
import '../utils/gw_youtube.dart';
import '../widgets/gw_youtube_player.dart';

/// ============================================================
/// GwPostSlider（統一版 / iframe）
///
/// ✅ 役割（初心者向け）
/// - 記事先頭の「画像/YouTube」スライダーUI
/// - 上：メイン表示（16:9）
/// - 下：サムネ一覧（横スクロール）
/// - 左右ボタン & 指の左右スワイプで移動
///
/// ✅ 今回の重要要件
/// 1) YouTube再生中でも “指で左右スワイプ” で次/前に移動できる
///    → YouTubeのiframeがタッチを奪うので、
///       GwYoutubePlayer(enableTapToPlay:false) + 上にGestureDetectorを被せる
/// 2) 別スライドへ移動したら前の動画は止まる
///    → _indexが変わるとキーが変わり、古いGwYoutubePlayerがdisposeされ stopVideo() される
///
/// 重要：macOS/Windows/Linux は YouTube player を生成せずサムネ固定（白画面回避）
/// ============================================================
class GwPostSlider extends StatefulWidget {
  final List<GwSliderItem> items;

  /// 任意：初期表示index
  final int initialIndex;

  const GwPostSlider({super.key, required this.items, this.initialIndex = 0});

  @override
  State<GwPostSlider> createState() => _GwPostSliderState();
}

class _GwPostSliderState extends State<GwPostSlider> {
  late int _index;

  // 下サムネを追従させる
  final ScrollController _thumbCtrl = ScrollController();

  // サムネのレイアウト定数（ListView側と合わせる）
  static const double _thumbW = 118.0;
  static const double _thumbGap = 8.0;
  static const double _thumbPadH = 12.0;

  // ✅ 指スワイプ判定用（移動距離）
  double _dragDx = 0;

  bool get _canPlayYoutube {
    if (kIsWeb) return true;
    return defaultTargetPlatform == TargetPlatform.iOS ||
        defaultTargetPlatform == TargetPlatform.android;
  }

  @override
  void initState() {
    super.initState();
    _index = widget.items.isEmpty
        ? 0
        : widget.initialIndex.clamp(0, widget.items.length - 1);

    // 初期表示でも選択中が見える位置へ
    WidgetsBinding.instance.addPostFrameCallback((_) {
      _scrollThumbToIndex(_index, jump: true);
    });
  }

  @override
  void dispose() {
    _thumbCtrl.dispose();
    super.dispose();
  }

  @override
  void didUpdateWidget(covariant GwPostSlider oldWidget) {
    super.didUpdateWidget(oldWidget);

    if (widget.items.isEmpty) {
      _index = 0;
      return;
    }

    // items更新で index がはみ出たら補正
    if (_index >= widget.items.length) {
      setState(() => _index = widget.items.length - 1);
      WidgetsBinding.instance.addPostFrameCallback((_) {
        _scrollThumbToIndex(_index, jump: true);
      });
    }

    // initialIndex が変わった場合も追従（必要なら）
    if (oldWidget.initialIndex != widget.initialIndex) {
      final next = widget.initialIndex.clamp(0, widget.items.length - 1);
      if (next != _index) {
        setState(() => _index = next);
        WidgetsBinding.instance.addPostFrameCallback((_) {
          _scrollThumbToIndex(_index, jump: true);
        });
      }
    }
  }

  void _scrollThumbToIndex(int i, {bool jump = false}) {
    if (!_thumbCtrl.hasClients) return;

    final target = (_thumbW + _thumbGap) * i - _thumbPadH;
    final clamped = target
        .clamp(0.0, _thumbCtrl.position.maxScrollExtent)
        .toDouble();

    if (jump) {
      _thumbCtrl.jumpTo(clamped);
    } else {
      _thumbCtrl.animateTo(
        clamped,
        duration: const Duration(milliseconds: 220),
        curve: Curves.easeOut,
      );
    }
  }

  void _setIndex(int next) {
    if (widget.items.isEmpty) return;
    if (next < 0 || next >= widget.items.length) return;
    if (next == _index) return;

    /// ✅ ここで _index が変わる → メインが作り直される
    /// YouTubeなら key が変わり、古いプレイヤーdispose→stopされる
    setState(() => _index = next);
    _scrollThumbToIndex(next);
  }

  void _prev() {
    if (widget.items.isEmpty) return;
    final next = (_index - 1) < 0 ? widget.items.length - 1 : _index - 1;
    _setIndex(next);
  }

  void _next() {
    if (widget.items.isEmpty) return;
    final next = (_index + 1) >= widget.items.length ? 0 : _index + 1;
    _setIndex(next);
  }

  void _tapThumb(int i) => _setIndex(i);

  String? _videoIdFrom(String raw) {
    final t = raw.trim();
    if (t.isEmpty) return null;
    return gwExtractYoutubeId(t) ?? t;
  }

  String? _youtubeThumbFrom(String raw) {
    final id = _videoIdFrom(raw);
    if (id == null) return null;
    return 'https://i.ytimg.com/vi/$id/hqdefault.jpg';
  }

  @override
  Widget build(BuildContext context) {
    if (widget.items.isEmpty) return const SizedBox.shrink();

    final item = widget.items[_index];

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        // ===== メイン（16:9） =====
        Stack(
          children: [
            AspectRatio(aspectRatio: 16 / 9, child: _buildMain(item)),

            /// ✅ 追加：YouTube再生中でも “左右スワイプで移動”
            /// - YouTubeは自分でスワイプできない（iframeがタッチを奪う）
            /// - だから上にGestureDetectorを「全面に被せる」
            Positioned.fill(
              child: GestureDetector(
                behavior: HitTestBehavior.translucent,
                onHorizontalDragStart: (_) => _dragDx = 0,
                onHorizontalDragUpdate: (d) => _dragDx += d.delta.dx,
                onHorizontalDragEnd: (d) {
                  final v = d.primaryVelocity ?? 0;

                  // 速度があるスワイプを優先
                  if (v.abs() > 250) {
                    if (v > 0) {
                      _prev();
                    } else {
                      _next();
                    }
                    return;
                  }

                  // 速度が弱い時は移動距離で判定
                  if (_dragDx.abs() > 40) {
                    if (_dragDx > 0) {
                      _prev();
                    } else {
                      _next();
                    }
                  }
                },
              ),
            ),

            // 左矢印
            Positioned(
              left: 8,
              top: 0,
              bottom: 0,
              child: Center(
                child: _ArrowButton(icon: Icons.chevron_left, onTap: _prev),
              ),
            ),

            // 右矢印
            Positioned(
              right: 8,
              top: 0,
              bottom: 0,
              child: Center(
                child: _ArrowButton(icon: Icons.chevron_right, onTap: _next),
              ),
            ),
          ],
        ),

        const SizedBox(height: 8),

        // ===== サムネ（横スクロール） =====
        SizedBox(
          height: 74,
          child: ListView.separated(
            controller: _thumbCtrl,
            scrollDirection: Axis.horizontal,
            padding: const EdgeInsets.symmetric(horizontal: _thumbPadH),
            itemCount: widget.items.length,
            separatorBuilder: (_, __) => const SizedBox(width: _thumbGap),
            itemBuilder: (context, i) {
              final it = widget.items[i];
              final selected = i == _index;

              final thumbUrl = (it.thumb != null && it.thumb!.trim().isNotEmpty)
                  ? it.thumb!.trim()
                  : (it.type == 'youtube' ? _youtubeThumbFrom(it.src) : it.src);

              return InkWell(
                onTap: () => _tapThumb(i),
                child: Opacity(
                  opacity: selected ? 1.0 : 0.6,
                  child: Container(
                    width: _thumbW,
                    decoration: BoxDecoration(
                      borderRadius: BorderRadius.circular(10),
                      border: Border.all(
                        color: selected
                            ? Colors.blueAccent
                            : Colors.transparent,
                        width: 2,
                      ),
                      color: Colors.black12,
                    ),
                    clipBehavior: Clip.antiAlias,
                    child: thumbUrl == null
                        ? Center(
                            child: Icon(
                              it.type == 'youtube'
                                  ? Icons.play_circle
                                  : Icons.image,
                            ),
                          )
                        : CachedNetworkImage(
                            imageUrl: thumbUrl,
                            fit: BoxFit.cover,
                            placeholder: (_, __) => const Center(
                              child: CircularProgressIndicator(strokeWidth: 2),
                            ),
                            errorWidget: (_, __, ___) =>
                                const Center(child: Icon(Icons.broken_image)),
                          ),
                  ),
                ),
              );
            },
          ),
        ),
      ],
    );
  }

  /// メイン表示（画像 or YouTube）
  Widget _buildMain(GwSliderItem item) {
    if (item.type == 'youtube') {
      final id = _videoIdFrom(item.src);
      if (id == null) {
        return const Center(child: Icon(Icons.play_circle, size: 56));
      }

      // ✅ macOS/Windows/Linux はプレイヤー生成しない（白画面回避）
      if (!_canPlayYoutube) {
        final thumb = 'https://i.ytimg.com/vi/$id/hqdefault.jpg';
        return CachedNetworkImage(
          imageUrl: thumb,
          fit: BoxFit.cover,
          placeholder: (_, __) => Container(color: Colors.black12),
          errorWidget: (_, __, ___) =>
              const Center(child: Icon(Icons.play_circle, size: 56)),
        );
      }

      // ✅ 再生できる端末だけ player
      // 重要：enableTapToPlay=false（スワイプ優先）
      // 重要：keyを index と id に含める → 切替で古いplayerがdispose→stopされる
      return RepaintBoundary(
        child: ClipRect(
          child: GwYoutubePlayer(
            key: ValueKey('yt-$id-$_index'),
            videoId: id,
            autoplay: true,
            mute: true,
            showYoutubeControls: false,
            enableTapToPlay: false,
          ),
        ),
      );
    }

    // image
    return CachedNetworkImage(
      imageUrl: item.src,
      fit: BoxFit.cover,
      placeholder: (_, __) => const Center(child: CircularProgressIndicator()),
      errorWidget: (_, __, ___) =>
          const Center(child: Icon(Icons.broken_image)),
    );
  }
}

/// 矢印ボタン（半透明の丸ボタン）
class _ArrowButton extends StatelessWidget {
  final IconData icon;
  final VoidCallback onTap;

  const _ArrowButton({required this.icon, required this.onTap});

  @override
  Widget build(BuildContext context) {
    return Material(
      color: Colors.black45,
      shape: const CircleBorder(),
      clipBehavior: Clip.antiAlias,
      child: InkWell(
        onTap: onTap,
        child: const SizedBox(
          width: 40,
          height: 40,
          child: Center(child: Icon(Icons.chevron_left, color: Colors.white)),
        ),
      ),
    );
  }
}
